# 复制为 .env 后在本机填写；真实 .env 已被 Git 忽略。
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=online_shopping
DB_USER=shopping_app
DB_PASSWORD=replace_with_local_password

# 仅当初始化账号与运行账号不同才填写；不要在公开文档中记录实际值。
# 初始化账号需要 CREATE DATABASE、建表和写入示例数据权限。
# DB_INIT_USER=
# DB_INIT_PASSWORD=

# 可选：真实数据库集成测试专用库，名称必须以 _test 结尾。
# DB_TEST_NAME=online_shopping_test
