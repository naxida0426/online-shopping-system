# 复制为 .env 后在本机填写；真实 .env 已被 Git 忽略。
PORT=3000
# session:setup 会在本机生成随机值；不要把真实密钥提交到 Git。
SESSION_SECRET=replace_with_random_session_secret
# 公网 HTTPS 部署时设为 production；仅在受信任的反向代理后设置 TRUST_PROXY=1。
NODE_ENV=development
TRUST_PROXY=0
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=online_shopping
DB_USER=shopping_app
DB_PASSWORD=replace_with_local_password

# 仅当初始化账号与运行账号不同才填写；不要在公开文档中记录实际值。
# 初始化账号需要 CREATE DATABASE、建表和写入示例数据权限。
# DB_INIT_USER=
# DB_INIT_PASSWORD=

# 可选：真实数据库集成测试专用库，名称必须以 _test 结尾。
# DB_TEST_NAME=online_shopping_test

# 首位管理员：仅在本机填写，创建后可移除初始化密码。无公开默认账号。
# BOOTSTRAP_ADMIN_USERNAME=
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=

# 订单确认邮件默认关闭；配置后手动启用。465 通常用 true，587 通常用 false（STARTTLS）。
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
