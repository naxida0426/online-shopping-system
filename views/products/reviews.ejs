<section class="order-card product-reviews" aria-labelledby="reviews-title">
  <h2 id="reviews-title">购买评价</h2>
  <% if (feedback.total) { %><p class="review-rating"><strong><%= feedback.average %> / 5</strong> · <%= feedback.total %> 条评价</p><% } else { %><p>暂无评价</p><% } %>
  <% feedback.reviews.forEach(review => { %><article class="order-review-item"><div class="review-heading"><strong><%= review.author %></strong><span><%= review.createdAt %></span></div><p class="review-rating"><%= '★'.repeat(review.rating) %><%= '☆'.repeat(5 - review.rating) %></p><p class="review-content"><%= review.content %></p></article><% }) %>
  <% if (feedback.totalPages > 1) { %><nav class="payment-actions" aria-label="评价分页"><% if (feedback.page > 1) { %><a class="btn btn-outline-brand" href="/products/<%= product.id %>?reviewPage=<%= feedback.page - 1 %>">上一页</a><% } %><span>第 <%= feedback.page %> / <%= feedback.totalPages %> 页</span><% if (feedback.page < feedback.totalPages) { %><a class="btn btn-outline-brand" href="/products/<%= product.id %>?reviewPage=<%= feedback.page + 1 %>">下一页</a><% } %></nav><% } %>
</section>
