<%- include('../partials/header') %>
<main id="main-content" class="container-xl lab-page account-page">


  <div class="account-heading"><div><h1>你好，<%= currentUser.username %></h1><p>欢迎来到你的实验室账户。</p></div><div class="account-quick-links"><% if(currentUser.role==='admin'){ %><a class="btn btn-brand" href="/admin">管理后台</a><% } %><a class="btn btn-outline-brand" href="/orders">我的订单</a><a class="btn btn-outline-brand" href="/account/addresses">收货地址簿</a><a class="btn btn-outline-brand" href="/account/favorites">我的收藏</a><a class="btn btn-outline-brand" href="/products">继续逛逛 <span aria-hidden="true">→</span></a></div></div>
  <section class="lab-panel account-card" aria-labelledby="account-info"><h2 id="account-info">账户信息</h2><dl class="account-details"><div><dt>用户名</dt><dd><%= currentUser.username %></dd></div><div><dt>邮箱</dt><dd><%= currentUser.email %></dd></div><div><dt>账户类型</dt><dd><%= currentUser.role === 'admin' ? '管理员' : '顾客' %></dd></div><div><dt>注册时间</dt><dd><%= String(currentUser.created_at).slice(0, 10) %></dd></div></dl>
    <form action="/logout" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="btn btn-outline-brand">退出登录</button></form>
    <% if(currentUser.role === 'customer'){ %><a class="btn btn-outline-danger mt-3" href="/account/delete">注销账号</a><% } %>
  </section>
</main>
<%- include('../partials/footer') %>
