<%- include('../partials/header') %>
<main id="main-content" class="container-xl order-page">
  <div class="cart-heading"><h1>注销账号</h1><a href="/account" class="btn btn-outline-brand">返回账户</a></div>
  <section class="order-card address-form">
    <h2>注销 <%= currentUser.username %></h2>
    <p>注销后将无法登录此账号，购物车、收藏和地址簿会被清空。历史订单、支付记录和已提交评价保留。</p>
    <p>未支付订单仍按原支付期限自动关闭并恢复库存。原用户名和邮箱不再用于重新注册。</p>
    <% if (errorMessage) { %><div class="alert alert-danger" role="alert"><%= errorMessage %></div><% } %>
    <form action="/account/delete" method="post">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="mb-4"><label for="delete-password" class="form-label">当前密码</label><input id="delete-password" name="password" class="form-control" type="password" autocomplete="current-password" required maxlength="72"></div>
      <div class="form-check mb-4"><input id="confirm-deletion" class="form-check-input" type="checkbox" name="confirmDeletion" value="yes" required><label for="confirm-deletion" class="form-check-label">我确认注销账号并清除个人清单</label></div>
      <button class="btn btn-danger" type="submit">确认注销账号</button>
    </form>
  </section>
</main>
<%- include('../partials/footer') %>
