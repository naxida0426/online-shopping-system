<% if(featured){ %>
<a class="hero-product <%= featured.color %>" data-featured-id="<%= featured.id %>" href="<%= productUrl(featured.id,query,category,pagination.page) %>"><img src="<%= featured.image %>" alt="<%= featured.name %>" width="480" height="350" fetchpriority="high" data-product-image><span class="hero-product-caption"><strong><%= featured.name %></strong><span class="mono">¥<%= featured.price %> ↗</span></span></a>
<% }else{ %><div class="hero-product"><p>新一轮灵感即将入库</p><a class="btn btn-brand" href="/products">探索全部商品</a></div><% } %>
