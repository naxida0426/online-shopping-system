<dialog id="cart-drawer" class="cart-drawer" aria-labelledby="cart-drawer-title">
  <header class="drawer-header"><div><svg class="icon" aria-hidden="true"><use href="/images/icons.svg#bag"/></svg><h2 id="cart-drawer-title">我的灵感购物袋</h2><span class="cart-count" data-drawer-count>0</span></div><button type="button" class="drawer-close" data-close-cart aria-label="关闭购物袋">×</button></header>
  <div class="drawer-content" data-drawer-content aria-busy="false"><p class="drawer-loading" role="status">正在读取你的购物袋…</p></div>
  <div class="drawer-checkout" data-drawer-summary hidden></div>
  <footer class="drawer-footer"><a href="/cart" class="drawer-full-link">打开完整购物车 ↗</a></footer>
</dialog>
