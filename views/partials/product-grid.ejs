<span class="visually-hidden" data-catalog-count>共 <%= pagination.total %> 件</span>
<p class="catalog-hint" data-catalog-status role="status" hidden></p>
<% if(invalidCategory){ %><p class="catalog-hint">分类不存在或已停用，已切换到全部分类。</p><% } %>

<div class="product-grid" data-product-grid data-pages="<%= pagination.totalPages %>" data-page="<%= pagination.page %>" data-total="<%= pagination.total %>"><% products.forEach(product => { %><%- include('product-card',{product}) %><% }) %></div>
<div class="empty-state" data-catalog-empty <%= products.length ? 'hidden' : '' %>><h3><%= query ? '暂时没有找到这件好物' : '暂时没有可展示的好物' %></h3><p>换个关键词或分类，继续探索。</p><a href="/products" class="btn btn-brand">查看全部好物</a></div>
<%- include('pagination') %>
<div data-previews><% products.forEach(product => { %><%- include('product-preview',{product}) %><% }) %></div>
