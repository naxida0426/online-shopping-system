<div class="preview-palette" aria-label="<%= product.name %>背景配色预览"><span>配色预览</span><% [{name:'原色',color:''},{name:'荧光绿',color:'#eaffb0'},{name:'冰川蓝',color:'#dce2ff'},{name:'暖橙',color:'#ffcfb4'}].forEach((swatch,i) => { %><button type="button" class="swatch <%= i === 0 ? 'selected' : '' %>" style="--swatch:<%= swatch.color || '#F5F3EE' %>" data-preview-color="<%= swatch.color %>" aria-label="<%= swatch.name %>背景预览" aria-pressed="<%= i === 0 %>"></button><% }) %><small data-preview-label>原色</small></div>
