<article class="product-card">
  <a class="product-visual <%= product.color %>" href="<%= productUrl(product.id, query, category, pagination.page) %>" aria-label="查看<%= product.name %>详情">
    <span class="product-tag"><%= product.tag %></span>
    <img src="<%= product.image %>" alt="<%= product.name %>插画" width="480" height="350" loading="lazy" data-product-image>
    <span class="visual-open"><svg class="icon" aria-hidden="true"><use href="/images/icons.svg#arrow"/></svg></span>
  </a>
  <div class="product-info">
    <span class="product-category"><%= product.categoryName %> <span>· <%= product.isDemo ? '示例商品' : '商品展示' %></span></span>
    <h3><a href="<%= productUrl(product.id, query, category, pagination.page) %>"><%= product.name %></a></h3>
    <p class="product-description-short"><%= product.description %></p>
    <div class="product-bottom">
      <span class="price"><span>¥</span><%= product.price %></span>
      <button type="button" class="preview-button" data-bs-toggle="modal" data-bs-target="#product-<%= product.id %>">
        快速预览 <svg class="icon" aria-hidden="true"><use href="/images/icons.svg#expand"/></svg>
      </button>
    </div>
  </div>
</article>
