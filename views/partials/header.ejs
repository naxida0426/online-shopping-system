<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="VIBE LAB 灵感实验室：探索电子装备，开启你的生活实验。"><meta name="theme-color" content="#CCFF00">
  <title><%= title.replace(/拾光商城/g, 'VIBE LAB 灵感实验室') %></title>
  <link rel="icon" href="/images/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600;800&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>if(window.tailwind)tailwind.config={corePlugins:{preflight:false}};</script>
  <link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css">
  <link rel="stylesheet" href="/css/vibe-lab.css">
  <link rel="stylesheet" href="/css/cart-drawer.css">
  <style>body{background-color:#F5F3EE;background-image:radial-gradient(#000 1px,transparent 1px);background-size:24px 24px}.hard-shadow{border:2px solid #000;box-shadow:4px 4px 0 #000}.font-mono{font-family:'JetBrains Mono',monospace}</style>
</head>
<body>
<a class="skip-link" href="#main-content">跳到主要内容</a>
<header class="site-header">
  <nav class="container-xl header-grid <%= typeof catalogSearch !== 'undefined' && catalogSearch ? 'header-grid-catalog' : '' %>" aria-label="主导航">
    <a class="brand" href="/" aria-label="VIBE LAB 灵感实验室首页"><span class="brand-mark"><svg class="icon" aria-hidden="true"><use href="/images/icons.svg#sun"/></svg></span><span><strong>VIBE LAB</strong></span></a>
    <div class="main-nav"><a href="/" class="<%= activePage === 'home' ? 'active' : '' %>">实验室首页</a><a href="/products" class="<%= activePage === 'products' ? 'active' : '' %>">全部好物</a><a href="/orders">订单档案</a></div>
    <% if (typeof catalogSearch === 'undefined' || !catalogSearch) { %><%- include('product-search', {searchCategory:null}) %><% } %>
    <div class="header-actions"><% const count = typeof cartQuantity === 'number' ? cartQuantity : 0; %>
      <a href="/cart" class="cart-link" aria-label="购物车，<%= count %> 件商品"><svg class="icon" aria-hidden="true"><use href="/images/icons.svg#bag"/></svg>购物袋 <span class="cart-count"><%= count %></span></a>
      <% if (currentUser) { %><details class="account-menu"><summary><span class="account-email"><%= currentUser.email %></span></summary><div class="account-popover"><a href="/account">我的账户</a><a href="/account/addresses">收货地址簿</a><a href="/account/favorites">我的收藏</a><% if(currentUser.role === 'admin'){ %><a href="/admin">管理后台</a><% } %><form action="/logout" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-outline-brand" type="submit">退出登录</button></form></div></details>
      <% } else { %><a class="account-link" href="/login">登录</a><a class="register-link" href="/register">注册 ↗</a><% } %>
    </div>
  </nav>
</header>
