<div class="modal fade" id="product-<%= product.id %>" tabindex="-1" aria-labelledby="product-title-<%= product.id %>" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="关闭"></button></div><div class="modal-body"><div class="modal-product-image <%= product.color %>"><img src="<%= product.image %>" alt="<%= product.name %>" width="480" height="350" data-product-image></div><span class="product-category"><%= product.categoryName %><%= product.isDemo ? ' · 示例商品' : '' %></span><h2 id="product-title-<%= product.id %>"><%= product.name %></h2><p><%= product.description %></p><p class="price">¥<%= product.price %></p><dl class="detail-facts"><div><dt>SKU</dt><dd><%= product.sku %></dd></div><div><dt>库存</dt><dd><%= product.stock %> 件</dd></div></dl><%- include('swatches',{product}) %></div><div class="modal-footer"><button class="btn btn-outline-brand" data-bs-dismiss="modal">继续逛逛</button><a class="btn btn-brand" href="<%= productUrl(product.id,query,category,pagination.page) %>">查看详情 / 加购 ↗</a></div></div></div></div>
