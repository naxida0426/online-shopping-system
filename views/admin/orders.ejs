<%- include('../partials/header') %><main id="main-content" class="container-xl order-page"><%- include('nav') %><div class="cart-heading"><div><h1>订单管理</h1><p>共 <%= pagination.total %> 笔 · 第 <%= pagination.page %> / <%= pagination.totalPages %> 页</p></div></div><form class="order-filters" action="/admin/orders" method="get"><div><label for="a-order-q">订单号或用户名</label><input id="a-order-q" class="form-control" name="q" maxlength="50" value="<%= options.query %>"></div><div><label for="a-order-status">支付状态</label><select id="a-order-status" class="form-select" name="status"><% Object.entries({all:'全部',unpaid:'待支付',paid:'已支付',cancelled:'已取消'}).forEach(([v,label])=>{ %><option value="<%= v %>" <%= options.status===v?'selected':'' %>><%= label %></option><% }) %></select></div><button class="btn btn-brand">查询</button></form><div class="table-responsive admin-table"><table class="table align-middle"><caption>订单列表</caption><thead><tr><th>订单号</th><th>顾客</th><th>金额</th><th>订单 / 支付状态</th><th>操作</th></tr></thead><tbody><% orders.forEach(o=>{ %><tr><td class="order-number"><%= o.orderNo %></td><td><%= o.username %></td><td>¥<%= o.total %></td><td><%= orderLabels[o.orderStatus] %> / <%= paymentLabels[o.paymentStatus] %></td><td><a href="/admin/orders/<%= o.id %>">查看详情</a></td></tr><% }) %><% if(!orders.length){ %><tr><td colspan="5">没有符合条件的订单。</td></tr><% } %></tbody></table></div><%- include('pagination',{base:'/admin/orders'}) %></main><%- include('../partials/footer') %>
