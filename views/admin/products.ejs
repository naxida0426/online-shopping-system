<%- include('../partials/header') %><main id="main-content" class="container-xl order-page"><%- include('nav') %><div class="cart-heading"><div><span class="eyebrow">PRODUCTS</span><h1>商品管理</h1><p>共 <%= pagination.total %> 件 · 第 <%= pagination.page %> / <%= pagination.totalPages %> 页</p></div><a class="btn btn-brand" href="/admin/products/new">新增商品</a></div>
<form action="/admin/products" method="get" class="order-filters"><div><label for="admin-product-q">名称或 SKU</label><input class="form-control" id="admin-product-q" name="q" maxlength="100" value="<%= options.query %>"></div><div><label for="admin-product-status">状态</label><select class="form-select" id="admin-product-status" name="status"><% Object.entries({all:'全部',active:'已上架',inactive:'已下架',deleted:'已软删除'}).forEach(([v,label])=>{ %><option value="<%= v %>" <%= options.status===v?'selected':'' %>><%= label %></option><% }) %></select></div><button class="btn btn-brand" type="submit">查询</button></form>
<div class="table-responsive admin-table"><table class="table align-middle"><caption>商品管理列表；删除保留历史记录</caption><thead><tr><th>名称 / SKU</th><th>分类</th><th>价格</th><th>库存</th><th>状态</th><th>操作</th></tr></thead><tbody><% products.forEach(p=>{ %><tr><td><strong><%= p.name %></strong><small class="d-block"><%= p.sku %></small></td><td><%= p.categoryName %></td><td>¥<%= p.price %></td><td><%= p.stock %></td><td><%= ({active:'上架',inactive:'下架',deleted:'软删除'})[p.status] %></td><td><% if(p.status!=='deleted'){ %><a href="/admin/products/<%= p.id %>/edit">编辑</a> · <a href="/admin/products/<%= p.id %>/delete">软删除</a><% }else{ %>保留历史关系<% } %></td></tr><% }) %><% if(!products.length){ %><tr><td colspan="6">没有符合条件的商品。</td></tr><% } %></tbody></table></div><%- include('pagination',{base:'/admin/products'}) %></main><%- include('../partials/footer') %>
