<%- include('../partials/header') %><main id="main-content" class="container-xl order-page"><%- include('nav') %><div class="cart-heading"><h1>后台订单详情</h1><a class="btn btn-outline-brand" href="/admin/orders">返回订单列表</a></div><div class="order-card"><h2 class="order-number"><%= order.orderNo %></h2><p><%= orderLabels[order.orderStatus] %> / <%= paymentLabels[order.paymentStatus] %> · 创建 <%= order.createdAt %></p><% if(order.cancelReason){ %><p class="alert alert-info">关闭原因：<%= order.cancelReason === 'timeout' ? '超时未支付，系统自动关闭' : '顾客主动取消' %></p><% } %><% if(order.expiresAt){ %><p>支付截止：<%= order.expiresAt %></p><% } %><dl class="account-details"><div><dt>收货人</dt><dd><%= order.recipientName %></dd></div><div><dt>手机</dt><dd><%= order.recipientPhone %></dd></div><div><dt>地址</dt><dd><%= order.recipientAddress %></dd></div></dl><% order.items.forEach(i=>{ %><div class="checkout-item"><span><%= i.name %> × <%= i.quantity %></span><strong>¥<%= i.subtotal %></strong></div><% }) %><div class="cart-total"><span>订单合计</span><strong>¥<%= order.total %></strong></div><% const next=({confirmed:'shipped',shipped:'completed'})[order.orderStatus]; if(next && order.paymentStatus==='paid'){ %><form action="/admin/orders/<%= order.id %>/status" method="post" class="payment-actions mt-4"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="expectedStatus" value="<%= order.orderStatus %>"><input type="hidden" name="nextStatus" value="<%= next %>"><button type="submit" class="btn btn-brand">确认标记为<%= orderLabels[next] %></button></form><% }else{ %><p class="cart-summary-note">未支付、已取消或已完成的订单不能继续发货。支付状态由顾客模拟支付流程更新。</p><% } %></div></main><%- include('../partials/footer') %>
