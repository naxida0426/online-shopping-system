<% if(pagination.totalPages>1){ %><nav class="order-pagination" aria-label="管理列表分页"><ul class="pagination flex-wrap justify-content-center"><% pagination.items.forEach(page=>{ %><li class="page-item <%= page===pagination.page?'active':page===null?'disabled':'' %>"><% if(page===null){ %><span class="page-link">…</span><% }else{ %><a class="page-link" href="<%= adminPageUrl(base,options,page) %>" <%- page===pagination.page?'aria-current="page"':'' %>><%= page %></a><% } %></li><% }) %></ul></nav><% } %>
