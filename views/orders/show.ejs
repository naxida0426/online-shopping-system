<%- include('../partials/header') %>
<main id="main-content" class="container-xl order-page">
  <div class="cart-heading"><div><span class="eyebrow">YOUR ORDER</span><h1>订单详情</h1><p>订单已保存，可随时回来查看。</p></div><a href="<%= orderListUrl(browse) %>" class="btn btn-outline-brand">返回我的订单</a></div>
  <% if(notice){ %><div class="alert alert-success" role="status"><%= notice %></div><% } %><% if(errorMessage){ %><div class="alert alert-danger" role="alert"><%= errorMessage %></div><% } %>
  <div class="order-status-banner"><div><strong><%= orderLabels[order.orderStatus] || '处理中' %></strong><span class="order-payment"><%= paymentLabels[order.paymentStatus] || '处理中' %></span><p><% if(order.orderStatus==='cancelled'){ %><%= order.cancelReason === 'timeout' ? '订单因超时未支付自动关闭，下单扣减的库存已恢复。' : '订单已关闭，下单扣减的库存已恢复。' %><% }else if(order.paymentStatus==='paid'){ %>模拟支付已完成，不涉及真实扣款，未再次扣减库存。<% }else if(order.payment?.status==='cancelled'){ %>本次支付已取消，订单仍待支付。可以重试支付或取消订单释放库存。<% }else{ %>库存已在下单时扣减，请继续模拟支付或取消订单。<% } %></p></div><svg class="icon" aria-hidden="true"><use href="/images/icons.svg#bag"/></svg></div>
  <%- include('countdown') %>
  <% if(order.canPay){ %><div class="payment-actions order-action-bar"><a class="btn btn-brand" href="<%= orderUrl(order.id,browse,'pay') %>">前往模拟支付</a><a class="btn btn-outline-brand" href="<%= orderUrl(order.id,browse,'cancel') %>">取消订单</a></div><% } %>
  <div class="order-details-layout">
    <section class="order-card" aria-labelledby="order-info-title"><h2 id="order-info-title">订单信息</h2><dl class="account-details"><div><dt>订单编号</dt><dd class="order-number"><%= order.orderNo %></dd></div><div><dt>创建时间</dt><dd><%= order.createdAt %></dd></div><div><dt>收货人</dt><dd><%= order.recipientName %></dd></div><div><dt>手机号码</dt><dd><%= order.recipientPhone %></dd></div><div><dt>收货地址</dt><dd><%= order.recipientAddress %></dd></div></dl></section>
    <section class="order-card" aria-labelledby="order-items-title"><h2 id="order-items-title">商品明细</h2><p class="cart-summary-note mb-3">名称与价格保留下单时的记录，不随商品后续修改而变化。</p><div class="checkout-items"><% order.items.forEach(item => { %><div class="checkout-item"><div><strong><%= item.name %></strong><span>¥<%= item.price %> × <%= item.quantity %></span></div><strong>¥<%= item.subtotal %></strong></div><% }) %></div><div class="cart-total"><span>订单金额</span><strong>¥<%= order.total %></strong></div><a href="/products" class="btn btn-outline-brand mt-4">继续逛逛</a></section>
  </div>
  <section class="order-card payment-record"><h2>支付记录 · 课程模拟</h2><% if(order.payment){ %><dl class="account-details"><div><dt>支付单号</dt><dd class="order-number"><%= order.payment.paymentNo %></dd></div><div><dt>记录状态</dt><dd><%= recordLabels[order.payment.status] || '处理中' %></dd></div><div><dt>记录金额</dt><dd>¥<%= order.payment.amount %></dd></div><% if(order.payment.paidAt){ %><div><dt>支付时间</dt><dd><%= order.payment.paidAt %></dd></div><% } %><% if(order.cancelledAt){ %><div><dt>取消时间</dt><dd><%= order.cancelledAt %></dd></div><% } %></dl><% }else{ %><p>尚未发起模拟支付。</p><% } %><% if(order.paymentStatus==='paid'){ %><h2 class="mt-4">订单确认邮件</h2><p><%= emailLabels[order.emailStatus] || '尚未安排确认邮件' %></p><% if(['failed','skipped','pending','sending'].includes(order.emailStatus)){ %><form action="<%= orderUrl(order.id,browse,'email') %>" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-outline-brand">重试确认邮件</button></form><p class="cart-summary-note">重试间隔 60 秒，最多 5 次。邮件失败不影响订单。SMTP 接受不等于已送达收件箱。</p><% } %><% } %></section>
</main>
<%- include('../partials/footer') %>
