<%- include('../partials/header') %>
<main id="main-content" class="container-xl lab-page order-page address-page">


  <nav class="shop-breadcrumb" aria-label="位置"><% if (addressFromCheckout) { %><a href="/checkout?from=addresses">确认订单</a><% } else { %><a href="/account">我的账户</a><% } %><span aria-hidden="true">/</span><span aria-current="page">收货地址簿</span></nav>
  <div class="cart-heading"><div><h1>收货地址簿</h1><p>保存常用地址，结算更从容。已保存 <%= addresses.length %> / 20 个。</p></div><div class="address-page-actions"><% if (addressFromCheckout) { %><a class="btn btn-outline-brand" href="/checkout?from=addresses">返回结算</a><% } %><a class="btn btn-brand" href="/account/addresses/new<%= addressBookSuffix %>">新增地址</a></div></div>

  <% if (!addresses.length) { %><section class="lab-panel order-card"><h2>还没有保存收货地址</h2><p>添加第一个地址后，会自动将它设为默认地址。</p><a href="/account/addresses/new<%= addressBookSuffix %>" class="btn btn-outline-brand">添加收货地址</a></section><% } %>
  <div class="address-grid"><% addresses.forEach(address => { %>
    <section class="lab-panel order-card address-card" aria-label="<%= address.recipientName %>的收货地址">
      <div class="address-card-heading"><h2><%= address.recipientName %></h2><% if (address.isDefault) { %><span class="address-default">默认地址</span><% } %></div>
      <p><%= address.recipientPhone %></p><p class="address-text"><%= address.recipientAddress %></p>
      <div class="address-card-actions"><a class="btn btn-outline-brand" href="/account/addresses/<%= address.id %>/edit<%= addressBookSuffix %>">编辑</a>
        <% if (!address.isDefault) { %><form method="post" action="/account/addresses/<%= address.id %>/default<%= addressBookSuffix %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-outline-brand" type="submit">设为默认</button></form><% } %>
        <a class="btn btn-outline-brand" href="/account/addresses/<%= address.id %>/delete<%= addressBookSuffix %>">删除</a>
      </div>
    </section>
  <% }) %></div>
</main>
<%- include('../partials/footer') %>
