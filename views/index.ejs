<%- include('partials/header') %>
<main id="main-content" class="container-xl home-page">

  <section class="bento-grid" aria-labelledby="hero-title">
    <article class="hero-feature">
      <div class="hero-feature-body"><div class="hero-copy"><h1 id="hero-title">让科技，<br>更有<mark>个性。</mark></h1><a class="btn btn-dark" href="/products" data-scroll-products>进入灵感仓库 ↗</a></div>
      <%- include('partials/featured-product',{featured}) %></div>

    </article>
    <%- include('partials/flash-card',{flashOffer}) %>
    <article class="blind-card"><div class="blind-heading"><h2>灵感盲盒<br>抽取 ¥50–100</h2><span class="blind-stamp" aria-hidden="true">?</span></div><div class="coupon-output mono" data-coupon-output aria-live="polite">[ 等待抽取 ]</div><div class="payment-actions"><% if(currentUser){ %><form action="/promotions/codes" method="post" data-draw-coupon-form><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="btn btn-dark" data-draw-coupon>抽取兑换码 ↗</button></form><% }else{ %><a href="/login?next=%2F" class="btn btn-dark">登录抽取兑换码 ↗</a><% } %><button type="button" class="btn btn-outline-brand" data-copy-coupon disabled>复制</button></div><p data-draw-feedback role="status"></p></article>
  </section>

  <section class="catalog-shell" aria-label="全部商品"><%- include('partials/category-nav') %><section id="products" class="products-section" aria-label="商品列表"><%- include('partials/product-grid') %></section></section>
</main><%- include('partials/footer') %>
